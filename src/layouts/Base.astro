---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { url } from "../lib/url";
import interCyr from "../fonts/inter-tight-cyrillic-wght-normal.woff2?url";
import monoCyr from "../fonts/jetbrains-mono-cyrillic-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  home?: boolean; // главная: заставка при первом заходе и небо по прокрутке
  form?: boolean; // на странице есть форма заявки
  noindex?: boolean;
  led?: boolean; // на странице светодиодное табло: подключаем маски знаков
}
const { title, description, home = false, form = false, noindex = false, led = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/", Astro.site);
const ogImage = new URL("/assets/img/og.jpg", Astro.site);
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
  <link rel="canonical" href={canonical}>
  <meta name="theme-color" content="#121418">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="ru_RU">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml">
  {led && <link rel="stylesheet" href={url("/led.css")}>}
  <link rel="preload" href={interCyr} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={monoCyr} as="font" type="font/woff2" crossorigin>
  {home ? (
    <script is:inline>
      // JS работает: блоки можно прятать до появления. Заставка только при первом заходе и без неё при reduced motion
      (function () {
        var h = document.documentElement, seen = false;
        h.classList.add("js");
        try { seen = localStorage.getItem("v14-intro") === "1"; } catch (e) {}
        if (/[?&]intro=1/.test(location.search)) seen = false;
        if (!seen && !matchMedia("(prefers-reduced-motion: reduce)").matches) h.classList.add("has-intro");
      })();
    </script>
  ) : (
    <script is:inline>document.documentElement.classList.add("js");</script>
  )}
  <slot name="head" />
  {form && <script is:inline src={url("/assets/js/form.js")} defer></script>}
</head>
<body>
  <a class="skip-link" href="#main">Перейти к содержимому</a>
  <slot name="before" />
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <script>
    import "../scripts/site.ts";
  </script>
</body>
</html>
