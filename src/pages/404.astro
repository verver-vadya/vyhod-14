---
import Base from "../layouts/Base.astro";
import Led from "../components/Led.astro";
import { url } from "../lib/url";
---
<Base title="Страница не найдена — Выход 14" description="Такой страницы на сайте визового центра «Выход 14» нет." noindex led>
  <section class="pagehead notfound">
    <div class="wrap pagehead__in">
      <p class="eyebrow">Ошибка 404</p>
      <h1>Такого выхода нет</h1>
      <p class="muted">Возможно, ссылка устарела или в адресе опечатка. Табло ниже подскажет, куда можно пройти.</p>
      <div class="board board--mini">
        <div class="board__head"><span class="board__title">Рейс</span><span class="board__clock">404</span></div>
        <ul class="board__rows">
          <li><div class="row"><Led text="ВЫХОД 404" len={9} class="c-country" /><Led text="ОТМЕНЁН" len={13} class="c-status" /></div></li>
        </ul>
      </div>
      <div class="hero__actions">
        <a class="btn btn--signal" href={url("/")}><span class="btn__in">На главную</span></a>
        <a class="btn btn--glass" href={url("/vizy/")}><span class="btn__in">Все визы</span></a>
      </div>
    </div>
  </section>
</Base>
