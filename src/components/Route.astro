---
// Четыре остановки от заявки до паспорта. На главной самолёт летит вместе с прокруткой (home.ts),
// на других страницах маршрут статичный
interface Props { steps: { code: string; title: string; text: string }[]; animated?: boolean }
const { steps, animated = false } = Astro.props;
---
<div class:list={["route__line", { "route--static": !animated }]} id={animated ? "route" : undefined}>
  {animated && (
    <div class="route__track" aria-hidden="true"><span class="route__fill"></span><span class="route__plane">
      <svg viewBox="0 0 24 24" width="28" height="28"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z" fill="currentColor"/></svg>
    </span></div>
  )}
  <ol class="route__stops">
    {steps.map((s) => (
      <li class="stop">
        <span class="stop__code">{s.code}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>
</div>
